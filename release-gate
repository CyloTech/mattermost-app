#!/usr/bin/env python3
"""Release gate for the Appbox Mattermost image.

Usage: ./release-gate repo.cylo.net/mattermost:<version>

Run on the builder after `docker build` and before `docker push`. Exits 0
only when the local image passes two fresh installs, a restart, and upgrades
from the 11.3.0 and 12.0.0-2 images on the same data; every stop of the
image shuts Postgres down cleanly within the Appbox grace period, every
restart also copes with the stale lock file a killed container leaves
behind, and the registry positively reports that the tag does not exist yet.
Any other result, including an unreachable or ambiguous registry, exits
non-zero.

Security checks: a fresh install has its own database password (in a 0600
file and the DSN), Postgres refuses the old shared password and listens on
127.0.0.1 only, the config holds none of the values older images shipped,
and no secret appears in the logs, a command line or the image environment.
An upgraded install keeps its DSN, link salt and pg_hba.conf, and Postgres
stops listening on the container's network address.
"""

import errno
import http.client
import json
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

REGISTRY = "repo.cylo.net"
REPOSITORY = "mattermost"
# Images an existing install can be updated from, pinned by digest so the
# upgrade tests always start from the same releases: the 11.3.0 image
# customers run today (published as :latest) and the current default.
BASELINES = [
    ("11.3.0", "11.3.0", "repo.cylo.net/mattermost@sha256:"
     "a480b8c206102379058e397d7b66cfcb0cccf2916170cc25b3e34c23ab083c29"),
    ("12.0.0-2", "12.0.0", "repo.cylo.net/mattermost@sha256:"
     "08ab78842342ab3c7a7807166c7712cf8ee575e4bf81e74dc11a43771a8c154e"),
]
# Every install made by the older images shares these. A new install must
# not contain any of them.
LEGACY_DB_PASSWORD = "mmdefault"
LEGACY_SECRETS = {
    LEGACY_DB_PASSWORD,
    "7rAh6iwQCkV4cA1Gsg3fgGOXJAQ43QVg",  # SqlSettings.AtRestEncryptKey
    "A705AklYF8MFDOfcwh3I488G8vtLlVip",  # FileSettings.PublicLinkSalt
    "bjlSR4QqkXFBr7TP4oDzlfZmcNuH9YoS",  # EmailSettings.InviteSalt
    "vZ4DcKyVVRlKHHJpexcuXzojkE5PZ5eL",  # EmailSettings.PasswordResetSalt
}
CONFIG = Path("mattermost/config/config_docker.json")  # in the /mm volume
DB_PASSWORD_FILE = Path(".db_password")  # in the /mm volume
DSN_RE = re.compile(r"^postgres://postgres:(?P<password>[^@]*)@127\.0\.0\.1:5432/")
# /proc/net/tcp: port 5432 in hex, the LISTEN state and IPv4 127.0.0.1.
PG_PORT_HEX = "1538"
TCP_LISTEN = "0A"
LOOPBACK_HEX = "0100007F"
# Matches the catalogue limits for the app (2 GB memory, no extra swap).
MEMORY_LIMIT = "2g"
# serverapi stops containers with the image's stop signal and SIGKILLs them
# after this many seconds.
STOP_GRACE = 30
# The shared builder's disk is often busy; a first start (download, database
# migrations, plugins) has taken over 12 minutes there.
START_TIMEOUT = 1800
# Postgres logs this when it refuses to start because of an existing lock
# file, whether the file names a live process or holds unreadable data.
STALE_LOCK = 'lock file "postmaster.pid"'
IMAGE_RE = re.compile(
    r"^repo\.cylo\.net/mattermost:(?P<version>\d+\.\d+\.\d+)(?:-\d+)?$"
)


class GateFailure(Exception):
    pass


def docker(*args, check=True):
    result = subprocess.run(
        ["docker", *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode != 0:
        raise GateFailure(
            f"docker {' '.join(args[:2])} failed: {result.stderr.strip()}"
        )
    return result


def start(image, name, data_dir):
    docker(
        "run", "-d", "--name", name, "--init",
        "--memory", MEMORY_LIMIT, "--memory-swap", MEMORY_LIMIT,
        # Send the install callback nowhere instead of to production.
        "--add-host", "api.cylo.io:127.0.0.1",
        "-v", f"{data_dir / 'mm'}:/mm",
        "-v", f"{data_dir / 'pg'}:/var/lib/postgresql/data",
        image,
    )


def stop_cleanly(name, data_dir):
    """Stop the container as Appbox does and require a clean shutdown.

    Postgres removes postmaster.pid only when it shuts down cleanly, so a
    leftover file means it was killed at the end of the grace period.
    """
    began = time.monotonic()
    docker("stop", "-t", str(STOP_GRACE), name)
    took = time.monotonic() - began
    status = docker("inspect", "-f", "{{.State.ExitCode}}", name).stdout.strip()
    if (data_dir / "pg" / "postmaster.pid").exists():
        raise GateFailure(
            f"{name}: Postgres did not shut down cleanly ({took:.0f}s, "
            f"exit {status})"
        )
    if status != "0":
        raise GateFailure(f"{name}: exited {status} when stopped")
    print(f"  {name} stopped cleanly in {took:.0f}s", flush=True)


def leave_stale_lock(data_dir):
    """Leave a postmaster.pid that Postgres will always refuse.

    Stopping the container kills Postgres without a clean shutdown, so its
    lock file stays behind. Postgres refuses it only when the old PID now
    belongs to a live process of the postgres user, which depends on timing.
    A PID of 0 is refused every time ("bogus data in lock file"), so the
    container only starts if the entry script clears the file first.
    """
    pid_file = data_dir / "pg" / "postmaster.pid"
    lines = pid_file.read_text().splitlines() if pid_file.exists() else []
    pid_file.write_text("\n".join(["0"] + lines[1:]) + "\n")


def restart(name, data_dir, version):
    stop_cleanly(name, data_dir)
    leave_stale_lock(data_dir)
    docker("start", name)
    wait_ready(name, version)


def container_ip(name):
    out = docker(
        "inspect", "-f",
        "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}", name,
    ).stdout.strip()
    if not out:
        raise GateFailure(f"{name} has no IP address")
    return out


def api(ip, method, path, body=None, token=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"http://{ip}/api/v4{path}", data=data, method=method
    )
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw = resp.read()
            return resp.status, resp.headers, json.loads(raw) if raw else None
    except urllib.error.HTTPError as err:
        raw = err.read()
        try:
            payload = json.loads(raw) if raw else None
        except ValueError:
            payload = None
        return err.code, err.headers, payload


def expect(status, wanted, what, payload):
    if status != wanted:
        detail = (payload or {}).get("id") if isinstance(payload, dict) else None
        raise GateFailure(f"{what}: HTTP {status} ({detail})")


def wait_ready(name, version):
    deadline = time.monotonic() + START_TIMEOUT
    last = "no response"
    while time.monotonic() < deadline:
        running = docker(
            "inspect", "-f", "{{.State.Running}}", name
        ).stdout.strip()
        if running != "true":
            state = docker(
                "inspect", "-f",
                "exit={{.State.ExitCode}} oom={{.State.OOMKilled}}", name,
            ).stdout.strip()
            logs = docker("logs", "--tail", "40", name, check=False)
            raise GateFailure(
                f"{name} stopped before it was ready ({state}):\n"
                f"{logs.stdout[-3000:]}{logs.stderr[-3000:]}"
            )
        logs = docker("logs", "--tail", "50", name, check=False)
        if STALE_LOCK in logs.stdout + logs.stderr:
            raise GateFailure(f"{name}: Postgres refused a stale lock file")
        try:
            status, headers, payload = api(
                container_ip(name), "GET", "/system/ping"
            )
            served = headers.get("X-Version-Id", "")
            if status == 200 and payload and payload.get("status") == "OK":
                if not served.startswith(version + "."):
                    raise GateFailure(
                        f"{name} serves {served!r}, expected {version}"
                    )
                print(f"  {name} ready: {served}", flush=True)
                return
            last = f"HTTP {status}"
        except (OSError, ValueError, http.client.HTTPException) as err:
            last = str(err)
        time.sleep(5)
    raise GateFailure(f"{name} not ready after {START_TIMEOUT}s: {last}")


def seed(ip):
    """Create the first admin, a team and a post through the public API."""
    suffix = secrets.token_hex(4)
    account = {
        "username": f"gate{suffix}",
        "email": f"gate{suffix}@example.com",
        "password": secrets.token_urlsafe(18) + "aA1!",
    }
    status, _, payload = api(ip, "POST", "/users", account)
    expect(status, 201, "create first user", payload)
    token = login(ip, account)
    status, _, team = api(
        ip, "POST", "/teams",
        {"name": f"gate{suffix}", "display_name": "Gate", "type": "O"}, token,
    )
    expect(status, 201, "create team", team)
    status, _, channel = api(
        ip, "GET", f"/teams/{team['id']}/channels/name/town-square",
        token=token,
    )
    expect(status, 200, "find town-square", channel)
    message = f"release gate {suffix}"
    status, _, post = api(
        ip, "POST", "/posts",
        {"channel_id": channel["id"], "message": message}, token,
    )
    expect(status, 201, "create post", post)
    return {
        "account": account,
        "team": team["name"],
        "post_id": post["id"],
        "message": message,
    }


def login(ip, account):
    status, headers, payload = api(
        ip, "POST", "/users/login",
        {"login_id": account["username"], "password": account["password"]},
    )
    expect(status, 200, "log in", payload)
    token = headers.get("Token")
    if not token:
        raise GateFailure("log in returned no session token")
    return token


def verify(ip, seeded):
    token = login(ip, seeded["account"])
    status, _, team = api(ip, "GET", f"/teams/name/{seeded['team']}", token=token)
    expect(status, 200, "read team", team)
    status, _, post = api(ip, "GET", f"/posts/{seeded['post_id']}", token=token)
    expect(status, 200, "read post", post)
    if post.get("message") != seeded["message"]:
        raise GateFailure("post content changed")


def mm_config(data_dir):
    return json.loads((data_dir / "mm" / CONFIG).read_text())


def kept_state(data_dir):
    """The per-install values an update or restart must not change."""
    cfg = mm_config(data_dir)
    return {
        "dsn": cfg["SqlSettings"]["DataSource"],
        "link_salt": cfg["FileSettings"].get("PublicLinkSalt"),
        "at_rest_key": cfg["SqlSettings"].get("AtRestEncryptKey"),
        "pg_hba": (data_dir / "pg" / "pg_hba.conf").read_bytes(),
    }


def postgres_listeners(name):
    """Local addresses with a listening socket on port 5432."""
    out = docker(
        "exec", name, "sh", "-c", "cat /proc/net/tcp /proc/net/tcp6 2>/dev/null"
    ).stdout
    found = set()
    for line in out.splitlines()[1:]:
        fields = line.split()
        if len(fields) < 4 or ":" not in fields[1]:
            continue
        address, port = fields[1].rsplit(":", 1)
        if port == PG_PORT_HEX and fields[3] == TCP_LISTEN:
            found.add(address)
    if not found:
        raise GateFailure(f"{name}: nothing listens on port 5432")
    return found


def postgres_reachable(ip):
    """Whether port 5432 accepts a TCP connection on the container address."""
    with socket.socket() as sock:
        sock.settimeout(5)
        result = sock.connect_ex((ip, 5432))
    if result == 0:
        return True
    if result in (errno.ECONNREFUSED, errno.EHOSTUNREACH, errno.ETIMEDOUT,
                  errno.EAGAIN):
        return False
    raise GateFailure(f"port 5432 check on {ip} indeterminate: errno {result}")


def check_postgres_local_only(name):
    listeners = postgres_listeners(name)
    if listeners != {LOOPBACK_HEX}:
        raise GateFailure(f"{name}: Postgres listens on {sorted(listeners)}")
    if postgres_reachable(container_ip(name)):
        raise GateFailure(f"{name}: Postgres accepts connections on the network")
    print(f"  {name}: Postgres listens on 127.0.0.1 only", flush=True)


def check_postgres_exposed(name):
    """The old images listen on every address; proves the check can fail."""
    if not postgres_reachable(container_ip(name)):
        raise GateFailure(f"{name}: expected the old image to expose Postgres")
    print(f"  {name}: Postgres reachable on the network (old image)", flush=True)


def check_legacy_password_refused(name):
    result = docker(
        "exec", "-e", f"PGPASSWORD={LEGACY_DB_PASSWORD}",
        "-e", "PGCONNECT_TIMEOUT=10", name,
        "psql", "-h", "127.0.0.1", "-U", "postgres", "-d", "mattermost",
        "-Atc", "select 1", check=False,
    )
    if result.returncode == 0:
        raise GateFailure(f"{name}: Postgres accepted the old shared password")
    if "password authentication failed" not in result.stderr:
        raise GateFailure(
            f"{name}: old password check indeterminate: {result.stderr.strip()}"
        )
    print(f"  {name}: Postgres refuses the old shared password", flush=True)


def check_pg_hba_requires_password(data_dir):
    for line in (data_dir / "pg" / "pg_hba.conf").read_text().splitlines():
        fields = line.split("#", 1)[0].split()
        if fields and fields[0].startswith("host") and fields[-1] == "trust":
            raise GateFailure(f"pg_hba.conf trusts TCP connections: {line}")


def check_not_exposed(name, data_dir, secret_values):
    """No secret in the container log, Mattermost's log file, a process
    command line or the container's configured environment."""
    logs = docker("logs", name, check=False)
    places = {"container log": logs.stdout + logs.stderr}
    log_file = data_dir / "mm" / "mattermost" / "logs" / "mattermost.log"
    if log_file.exists():
        places["mattermost.log"] = log_file.read_text(errors="replace")
    places["command lines"] = docker(
        "exec", name, "sh", "-c",
        "for p in /proc/[0-9]*; do tr '\\0' ' ' < $p/cmdline; echo; done",
        check=False,
    ).stdout
    places["image environment"] = docker(
        "inspect", "-f", "{{json .Config.Env}}", name
    ).stdout
    if "POSTGRES_PASSWORD=" in places["image environment"]:
        raise GateFailure(f"{name}: POSTGRES_PASSWORD is set in the image")
    for place, text in places.items():
        for value in secret_values:
            if value and value in text:
                raise GateFailure(f"{name}: a secret appears in the {place}")
    print(f"  {name}: no secret in logs, command lines or environment",
          flush=True)


def check_fresh_install(name, data_dir):
    """Security state of a new install; returns its secrets."""
    password_file = data_dir / "mm" / DB_PASSWORD_FILE
    config_file = data_dir / "mm" / CONFIG
    for path in (password_file, config_file):
        info = path.stat()
        if info.st_mode & 0o777 != 0o600 or info.st_uid != 1000:
            raise GateFailure(
                f"{path.name} is {oct(info.st_mode & 0o777)} uid {info.st_uid}, "
                "expected 0600 uid 1000"
            )
    password = password_file.read_text()
    if not re.fullmatch(r"[0-9a-f]{64}", password):
        raise GateFailure("database password file has an unexpected format")
    cfg = mm_config(data_dir)
    match = DSN_RE.match(cfg["SqlSettings"]["DataSource"])
    if not match or match["password"] != password:
        raise GateFailure("the DSN does not use the install's database password")
    text = config_file.read_text()
    if any(value in text for value in LEGACY_SECRETS):
        raise GateFailure("the config still holds a value older images shipped")
    level = cfg["LogSettings"]["ConsoleLevel"]
    if level != "INFO":
        raise GateFailure(f"ConsoleLevel is {level}, expected INFO")
    # The template has no salt; Mattermost generates one when it first loads
    # the config and writes it back.
    salt = cfg["FileSettings"].get("PublicLinkSalt") or ""
    if len(salt) < 32:
        raise GateFailure(f"{name}: Mattermost did not generate a link salt")
    check_pg_hba_requires_password(data_dir)
    check_postgres_local_only(name)
    check_legacy_password_refused(name)
    check_not_exposed(name, data_dir, [password, salt])
    print(f"  {name}: own database password and link salt, no shared "
          "values, INFO logs", flush=True)
    return {"password": password, "link_salt": salt}


def registry_tag_absent(tag):
    config = json.loads((Path.home() / ".docker" / "config.json").read_text())
    auth = config.get("auths", {}).get(REGISTRY, {}).get("auth")
    if not auth:
        raise GateFailure(f"no stored credentials for {REGISTRY}")
    req = urllib.request.Request(
        f"https://{REGISTRY}/v2/{REPOSITORY}/manifests/{tag}",
        headers={
            "Authorization": f"Basic {auth}",
            "Accept": ",".join([
                "application/vnd.oci.image.index.v1+json",
                "application/vnd.oci.image.manifest.v1+json",
                "application/vnd.docker.distribution.manifest.list.v2+json",
                "application/vnd.docker.distribution.manifest.v2+json",
            ]),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            digest = resp.headers.get("Docker-Content-Digest")
            raise GateFailure(
                f"{REGISTRY}/{REPOSITORY}:{tag} already exists ({digest})"
            )
    except urllib.error.HTTPError as err:
        if err.code != 404:
            raise GateFailure(f"registry check indeterminate: HTTP {err.code}")
        try:
            codes = {e.get("code") for e in json.loads(err.read())["errors"]}
        except (ValueError, KeyError, TypeError):
            raise GateFailure("registry check indeterminate: unreadable 404")
        if not codes & {"MANIFEST_UNKNOWN", "NAME_UNKNOWN"}:
            raise GateFailure(f"registry check indeterminate: {sorted(codes)}")
    except urllib.error.URLError as err:
        raise GateFailure(f"registry check indeterminate: {err.reason}")
    print(f"  {REGISTRY}/{REPOSITORY}:{tag} is not in the registry", flush=True)


def main():
    if len(sys.argv) != 2:
        raise GateFailure("usage: release-gate <image-reference>")
    image = sys.argv[1]
    match = IMAGE_RE.match(image)
    if not match:
        raise GateFailure(f"unexpected image reference: {image!r}")
    version = match["version"]
    tag = image.split(":", 1)[1]

    arch = docker(
        "image", "inspect", "-f", "{{.Os}}/{{.Architecture}}", image
    ).stdout.strip()
    if arch != "linux/amd64":
        raise GateFailure(f"{image} is {arch}, expected linux/amd64")

    run_id = secrets.token_hex(4)
    # Keep test data on disk next to the build context. Files written to a
    # tmpfs /tmp count against the container's memory limit and get the
    # test container OOM-killed, which never happens on Cylo storage.
    work = Path(tempfile.mkdtemp(prefix=".mattermost-gate.", dir=Path.cwd()))
    names = []

    def fresh_dir(label):
        path = work / label
        (path / "mm").mkdir(parents=True)
        (path / "pg").mkdir()
        return path

    try:
        installs = []
        for label in ("fresh-a", "fresh-b"):
            print(f"Fresh install {label}", flush=True)
            fresh = fresh_dir(label)
            name = f"mm-gate-{run_id}-{label}"
            names.append(name)
            start(image, name, fresh)
            wait_ready(name, version)
            found = check_fresh_install(name, fresh)
            installs.append(found)
            if label == "fresh-a":
                seeded = seed(container_ip(name))
                state = kept_state(fresh)
                restart(name, fresh, version)
                verify(container_ip(name), seeded)
                if kept_state(fresh) != state:
                    raise GateFailure(f"{name}: a restart changed the config")
                check_postgres_local_only(name)
                check_not_exposed(
                    name, fresh, [found["password"], found["link_salt"]]
                )
            stop_cleanly(name, fresh)
            docker("rm", name)
            shutil.rmtree(fresh, ignore_errors=True)
        first, second = installs
        if (first["password"] == second["password"]
                or first["link_salt"] == second["link_salt"]):
            raise GateFailure("two fresh installs share a password or salt")
        print("  the two fresh installs have different passwords and salts",
              flush=True)

        for label, baseline_version, baseline_image in BASELINES:
            print(f"Upgrade from {label}", flush=True)
            docker("pull", "-q", baseline_image)
            upgrade = fresh_dir(f"upgrade-{label}")
            name = f"mm-gate-{run_id}-from-{label}"
            names.append(name)
            start(baseline_image, name, upgrade)
            wait_ready(name, baseline_version)
            seeded = seed(container_ip(name))
            check_postgres_exposed(name)
            before = kept_state(upgrade)
            if not before["link_salt"]:
                raise GateFailure(f"{name}: baseline has no link salt")
            if mm_config(upgrade)["LogSettings"]["ConsoleLevel"] != "DEBUG":
                raise GateFailure(f"{name}: baseline console level is not DEBUG")
            shared = sorted(k for k in ("link_salt", "at_rest_key")
                            if before[k] in LEGACY_SECRETS)
            print(f"  {name}: values shared by all old installs: "
                  f"{', '.join(shared) or 'none'}", flush=True)
            # The 11.3.0 image cannot shut Postgres down cleanly.
            docker("stop", "-t", str(STOP_GRACE), name)
            docker("rm", name)
            leave_stale_lock(upgrade)

            name = f"mm-gate-{run_id}-upgraded-{label}"
            names.append(name)
            start(image, name, upgrade)
            wait_ready(name, version)
            verify(container_ip(name), seeded)
            after = kept_state(upgrade)
            for key in ("dsn", "link_salt", "pg_hba"):
                if after[key] != before[key]:
                    raise GateFailure(f"{name}: the update changed {key}")
            # Mattermost 12 no longer has AtRestEncryptKey and drops it.
            if after["at_rest_key"] not in (None, before["at_rest_key"]):
                raise GateFailure(f"{name}: the update changed AtRestEncryptKey")
            if (upgrade / "mm" / DB_PASSWORD_FILE).exists():
                raise GateFailure(f"{name}: the update made a new password file")
            level = mm_config(upgrade)["LogSettings"]["ConsoleLevel"]
            if level != "INFO":
                raise GateFailure(f"{name}: ConsoleLevel is {level}, expected INFO")
            check_postgres_local_only(name)
            print(f"  {name}: DSN, link salt and pg_hba.conf unchanged, "
                  "INFO logs", flush=True)

            # The owner can still choose DEBUG; the change to INFO is made once.
            stop_cleanly(name, upgrade)
            config_file = upgrade / "mm" / CONFIG
            config_file.write_text(config_file.read_text().replace(
                '"ConsoleLevel": "INFO"', '"ConsoleLevel": "DEBUG"'))
            leave_stale_lock(upgrade)
            docker("start", name)
            wait_ready(name, version)
            verify(container_ip(name), seeded)
            level = mm_config(upgrade)["LogSettings"]["ConsoleLevel"]
            if level != "DEBUG":
                raise GateFailure(f"{name}: the owner's DEBUG level was reset")
            after_restart = kept_state(upgrade)
            if after_restart != after:
                raise GateFailure(f"{name}: a restart changed the config")
            check_postgres_local_only(name)
            print(f"  {name}: restart kept the owner's console level", flush=True)
            stop_cleanly(name, upgrade)
            docker("rm", name)
            shutil.rmtree(upgrade, ignore_errors=True)

        print("Registry", flush=True)
        registry_tag_absent(tag)
    finally:
        for name in names:
            docker("rm", "-f", name, check=False)
        shutil.rmtree(work, ignore_errors=True)
        if work.exists():
            print(f"warning: could not remove {work}", file=sys.stderr)

    print(f"PASS {image}")


if __name__ == "__main__":
    try:
        main()
    except GateFailure as failure:
        print(f"FAIL {failure}", file=sys.stderr)
        sys.exit(1)
